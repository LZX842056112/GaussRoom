# 复制为 .env 后按本机情况填写。相对路径按仓库根目录解析。
# 本项目不需要任何密钥。

PORT=8123

# Python 解释器：默认即仓库内 uv 环境，通常无需修改
WORKBENCH_PYTHON=.venv/Scripts/python.exe

# COLMAP（解压到 tools/ 下，见 README「准备外部工具」）
COLMAP_GPU=tools/colmap-4.2.1-cuda/bin/colmap.exe
COLMAP_CPU=tools/colmap-4.2.1/bin/colmap.exe

# Brush 训练器
BRUSH=tools/brush-0.3.0/brush_app.exe

# ffmpeg / ffprobe：手机 HEIC/HEIF 上传与全部视频输入都依赖它们。
# 视频需要完整发行包（含 zscale / tonemap，用于把手机 HDR 转成 SDR）；
# 同目录需有 ffprobe，找不到时再查 PATH。
# 仅在「只用 JPEG 且不处理视频」时可以留空。
FFMPEG=
